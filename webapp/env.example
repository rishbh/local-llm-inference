# Copy this to a file called ".env" in this folder and edit it.
# ".env" is gitignored - never commit the real one.
#
#   Windows    copy env.example .env
#   Mac/Linux  cp env.example .env

# ---- Who can use it -------------------------------------------------------
# Leave empty and anyone with the tunnel URL can use it. Set it to anything
# before you expose this to the internet, and give the code to your testers.
ACCESS_CODE=

# ---- The model ------------------------------------------------------------
MODEL=medgemma1.5
OLLAMA_URL=http://127.0.0.1:11434

# ---- Generation (these match local-medgemma.py, change both or neither) ---
MAX_TOKENS=1600
NUM_CTX=4096
TEMPERATURE=0
REPEAT_PENALTY=1.1
REPEAT_LAST_N=256

# ---- Protecting a 16 GB machine -------------------------------------------
MAX_CONCURRENT=1
MAX_QUEUE=8
ANSWER_TIMEOUT_S=120
FIRST_TOKEN_TIMEOUT_S=45

# ---- Abuse ----------------------------------------------------------------
RATE_LIMIT_QUESTIONS=10
RATE_LIMIT_WINDOW_S=600
MAX_QUESTION_CHARS=500

# ---- Images ---------------------------------------------------------------
# 1 allows image questions, 0 refuses them. Either way the upload button only
# appears if Ollama reports that MODEL has a "vision" capability, so setting
# this to 1 cannot make a text-only model pretend to see.
ALLOW_IMAGES=1

# Ceiling on the decoded image, in bytes. The page shrinks anything larger
# than 1024px before uploading, so this really guards against a crafted
# request rather than an ordinary phone photo.
MAX_IMAGE_BYTES=4194304

# Both timeouts above are multiplied by this when an image is attached.
# Pushing a picture through the vision encoder on a CPU happens before the
# first token appears, so the text-sized budget would kill a question that was
# going to work. Raise it if image questions time out on your machine.
IMAGE_TIMEOUT_FACTOR=3

# ---- Logging --------------------------------------------------------------
# 0 keeps timings only. 1 also writes every question and answer to disk.
# Think about consent and retention before turning this on: a public health
# page collects real symptoms from real people.
LOG_QUESTIONS=0

# ---- Server ---------------------------------------------------------------
# Keep HOST on 127.0.0.1. cloudflared runs on the same machine and reaches it
# there; binding to 0.0.0.0 would also expose it to your whole local network.
HOST=127.0.0.1
PORT=8000
